---
import Search from "~/assets/icons/search.svg";

import { basics } from "~/data/cv.json";

const profiles = basics.profiles;
---

<dialog closedby="any">
  <section>
    <label for="search">
      <Search width="20" height="20" />
      <input
        type="search"
        name="search"
        id="search"
        placeholder="Escribe un comando o busca..."
      />
    </label>
    <hr />
    <ul role="group">
      <h5>Comandos</h5>
      <li
        role="option"
        aria-selected="false"
        data-selected="false"
        data-command="print"
        tabindex="0"
      >
        Imprimir
      </li>
      <li
        role="option"
        aria-selected="false"
        data-selected="false"
        tabindex="0"
      >
        Cambiar a modo oscuro
      </li>
    </ul>
    <ul role="group">
      <h5>Enlaces</h5>
      {
        profiles.map((profile) => (
          <li
            role="option"
            aria-selected="false"
            data-selected="false"
            tabindex="0"
          >
            <a href={profile.url} target="_blank" rel="noopener noreferrer">
              {profile.network}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</dialog>

<style>
  dialog {
    top: 0;
    bottom: 0;
    position: fixed;
    border: none;
    max-width: 672px;
    width: auto;
    background-color: transparent;
    color: #000;

    &:open::backdrop {
      background-color: rgba(255, 255, 255, 0.7);
    }

    section {
      width: 60%;
      margin: 0 auto;
      background-color: #fff;
      border: 1px solid #d1d5db;
      border-radius: 5px;

      label {
        display: inline-flex;
        gap: 10px;
        align-items: center;
        color: rgb(0, 0, 0, 0.5);
        height: auto;
        padding: 0px 12px;
        width: 100%;

        input {
          width: 100%;
          border: none;
          padding: 12px 0px;
          background-color: transparent;
          font-size: 14px;
          font-family: var(--font-monaspace-neon);
          vertical-align: middle;

          &::placeholder {
            color: rgb(0, 0, 0, 0.5);
          }

          &:focus-visible {
            border: none;
            outline: none;
          }
        }
      }

      hr {
        color: transparent;
        border: none;
        background-color: #d1d5db;
        height: 1px;
        margin-top: 0px;
      }

      ul {
        padding: 4px 8px;

        h5 {
          font-size: 12px;
          font-family: var(--font-geist), sans-serif;
          opacity: 40%;
          padding: 6px 8px;
          font-weight: 500;
        }

        li {
          font-family: var(--font-monaspace-neon);
          font-size: 14px;
          opacity: 65%;
          padding: 12px 8px;
          cursor: pointer;
          transition:
            background-color 150ms ease,
            color 150ms ease,
            opacity 150ms ease;

          &[data-selected="true"] {
            background-color: #f3f4f6;
            color: #111827;
            opacity: 100%;
          }

          &:focus,
          &:focus-visible {
            outline: none;
          }

          a {
            display: block;
            color: inherit;
            cursor: pointer;

            &:focus,
            &:focus-visible {
              outline: none;
            }
          }
        }

        &:last-child {
          padding-top: 0px;
        }
      }
    }
  }
</style>

<script>
  const dialog = document.querySelector("dialog") as HTMLDialogElement;
  const options = document.querySelectorAll<HTMLElement>('[role="option"]');
  const optionsList = Array.from(options);

  // open the dialog when the user presses the "Ctrl + j" keys
  function openDialog(e: KeyboardEvent) {
    if (e.ctrlKey && e.key === "j") {
      e.preventDefault();

      if (!dialog.open) {
        dialog.showModal();
      }

      const firstOption = optionsList[0];

      if (firstOption) {
        selectOption(firstOption);
        firstOption.focus();
      }
    }
  }

  function selectOption(option: HTMLElement) {
    options.forEach((item) => {
      const selected = item === option;

      item.dataset.selected = String(selected);
      item.setAttribute("aria-selected", String(selected));
    });
  }

  function activateOption(option: HTMLElement) {
    if (option.dataset.command === "print") {
      dialog.close();
      window.setTimeout(() => window.print(), 0);
      return;
    }

    option.querySelector<HTMLAnchorElement>("a")?.click();
  }

  function activateSelectedOption() {
    const selectedOption = optionsList.find(
      (option) => option.dataset.selected === "true",
    );

    if (selectedOption) {
      activateOption(selectedOption);
    }
  }

  function moveSelection(step: 1 | -1) {
    if (optionsList.length === 0) return;

    const currentIndex = optionsList.findIndex(
      (option) => option.dataset.selected === "true",
    );

    const nextIndex =
      currentIndex === -1
        ? step === 1
          ? 0
          : optionsList.length - 1
        : (currentIndex + step + optionsList.length) % optionsList.length;

    const nextOption = optionsList[nextIndex];
    selectOption(nextOption);
    nextOption.focus();
  }

  options.forEach((option) => {
    option.addEventListener("mouseenter", () => {
      selectOption(option);
      option.focus();
    });

    option.addEventListener("mousemove", () => {
      selectOption(option);
      option.focus();
    });

    option.addEventListener("focus", () => {
      selectOption(option);
    });

    option.addEventListener("click", (event) => {
      selectOption(option);
      option.focus();

      if (
        event.target instanceof Element &&
        event.target.closest("a") !== null
      ) {
        return;
      }

      activateOption(option);
    });
  });

  document.addEventListener("keydown", (event) => {
    if (dialog.open && event.key === "ArrowDown") {
      event.preventDefault();
      moveSelection(1);
      return;
    }

    if (dialog.open && event.key === "ArrowUp") {
      event.preventDefault();
      moveSelection(-1);
      return;
    }

    if (
      dialog.open &&
      event.key === "Enter" &&
      !(event.target instanceof HTMLAnchorElement)
    ) {
      event.preventDefault();
      activateSelectedOption();
    }
  });

  document.addEventListener("keydown", openDialog);
</script>
